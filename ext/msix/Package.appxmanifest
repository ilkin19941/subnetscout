<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="PLACEHOLDER.SubNetScout"
    Publisher="CN=PLACEHOLDER-GUID-FROM-PARTNER-CENTER"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>SubNet Scout</DisplayName>
    <PublisherDisplayName>PLACEHOLDER Ваше имя издателя из Partner Center</PublisherDisplayName>
    <Logo>Assets\Square150x150Logo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SubNetScout" Executable="app\subnetscout.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="SubNet Scout"
        Description="Fast network scanner — discover devices, open ports and hosts on your LAN"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Доступ в интернет: проверка обновлений, MAC-вендор базы и т.д. -->
    <Capability Name="internetClient" />
    <!-- Ключевая capability для сетевого сканера: обращение к другим хостам в локальной сети -->
    <Capability Name="privateNetworkClientServer" />
    <!-- Обязательна для jpackage/MSIX-упаковки Win32-приложений (full trust) -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
